# Gotenberg (HTML → PDF). Only used when the HTML to PDF service is installed (install.sh question, or ./gotenberg/enable.sh).
# Pages are opened by name inside the docker network, so the site domain must resolve there: every <siteCode>.<domain>
# is mapped to sclab-proxy. install.sh / enable.sh write the domain; run ./gotenberg/enable.sh again after changing it.
CHROMIUM_HOST_RESOLVER_RULES=MAP *.sclab-onprem sclab-proxy, MAP sclab-onprem sclab-proxy
# sclab-proxy serves the bundled (often self-signed) certificate.
CHROMIUM_IGNORE_CERTIFICATE_ERRORS=true
