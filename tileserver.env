# Map tile server (basemap tiles for map widgets). See README "Map tile server".
# Referer allowlist (space separated, nginx valid_referers syntax). Only these domains can load tiles.
# The site domain itself is set by install.sh; add customer portal domains here or register them in Admin > Tile Server.
TILESERVER_ALLOWED_REFERERS=sclab-onprem *.sclab-onprem
# Ask webapp for domains not in the list above (published site custom domains, Admin > Tile Server registrations).
TILESERVER_AUTH_URL=http://webapp:80/tile-auth
TILESERVER_AUTH_CACHE_TTL=10m
# Disk cache for rendered tiles
TILESERVER_CACHE_SIZE=5g
TILESERVER_CACHE_TTL=30d
# Internal settings (do not change)
NGINX_PORT=8080
TILESERVER_UPSTREAM=tileserver:8080
